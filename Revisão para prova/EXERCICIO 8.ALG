Algoritmo "Exercicio 8"


Var
   senha : caractere


Inicio
   Escreval("Insira a senha!")
   leia(senha)

   se (senha <> "abracadabra") entao
      escreval("Senha errada! Você será petrificado")
   senao
      escreval("E pra vaca da Ariana nada")
      escreval("Hit de Mayhem")
      escreval("Querido, entre.")
   fimse



Fimalgoritmo